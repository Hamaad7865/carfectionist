{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carfectionist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // populate_process_env: our compat date predates 2025-04-01, when Workers
  // began mirroring secrets/vars into process.env — without this flag every
  // process.env.<SECRET> read (PDF engine, WhatsApp keys, admin client) is
  // undefined in production while working fine in `next dev`.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "global_fetch_strictly_public"],
  // Custom domains are NOT declared here on purpose. `routes` replaces every trigger on
  // deploy, and the CI token cannot edit app-carfectionist.com's zone (the 2026-11-11
  // deploy failed on it) — declaring only app.hazsoftware.com detached the live shop
  // (HTTP 530). Both app-carfectionist.com and app.hazsoftware.com are attached on the
  // Worker already; a deploy without `routes` leaves them alone. Attach another with
  // `wrangler triggers deploy` from a login that owns the zone, listing ALL domains.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Email Sending (customer receipts). One-time dashboard step: Email >
  // Email Sending > enable app-carfectionist.com (DNS is auto-managed —
  // the zone lives on this account). Sends fail cleanly until then.
  "send_email": [{ "name": "EMAIL" }],
  // Browser Rendering — server-side HTML→PDF for emailed/WhatsApp documents.
  // The binding IS the auth (no account id / API token needed). Requires
  // Browser Rendering enabled on the account (free tier is sufficient).
  "browser": { "binding": "BROWSER" },
  "observability": {
    "enabled": true
  }
}
