{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carfectionist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Email Sending (customer receipts). One-time dashboard step: Email >
  // Email Sending > enable app-carfectionist.com (DNS is auto-managed —
  // the zone lives on this account). Sends fail cleanly until then.
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true
  }
}
