    "@tiptap/starter-kit": "^3.29.2",
    "lucide-react": "^1.23.0",
    "mimetext": "^3.0.28",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.4",
