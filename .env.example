# ── Carfectionist — CLI & seed environment ─────────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in the values from
# your hosted Supabase project. Used by the Supabase CLI (migrations, type
# generation) and the seed scripts — NOT by the browser.

# Settings → General → Reference ID (also the subdomain of your Project URL)
SUPABASE_PROJECT_REF=

# Settings → Database → Connection string → URI (use the "Session pooler" tab
# on IPv4 home networks). Replace [YOUR-PASSWORD] with your DB password.
SUPABASE_DB_URL=

# Settings → API → service_role / secret key.
# Server & seed scripts ONLY. Never ships to the browser or the Android app.
SUPABASE_SERVICE_ROLE_KEY=
