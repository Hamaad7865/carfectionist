<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose draws everything; this sets the window basics to the handoff's
         light palette so there's no dark flash and the system bars read light. -->
    <style name="Theme.CarfectionistPos" parent="android:Theme.Material.Light.NoActionBar" tools:targetApi="31">
        <item name="android:windowBackground">#F2F4F7</item>
        <item name="android:statusBarColor">#F2F4F7</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Launch window (API 31+): the gold mark on its black ground, matching the
             Compose splash that takes over on the first frame — no light flash between. -->
        <item name="android:windowSplashScreenBackground">#0B0D0F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0B0D0F</item>
    </style>
</resources>
